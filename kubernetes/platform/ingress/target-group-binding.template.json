{
  "apiVersion": "elbv2.k8s.aws/v1beta1",
  "kind": "TargetGroupBinding",
  "metadata": {"name": "portfolio-gateway", "namespace": "istio-ingress"},
  "spec": {
    "targetGroupARN": "${target_group_arn}",
    "targetType": "ip",
    "vpcID": "${vpc_id}",
    "serviceRef": {"name": "portfolio-gateway", "port": 443},
    "multiClusterTargetGroup": false
  }
}
