# Copy to local.auto.tfvars (untracked) and replace every value. It overrides the
# placeholders in terraform.tfvars. Never put a credential or secret value here.

project        = "myproj"
aws_account_id = "111122223333"

# The version ID returned when function.zip is uploaded to <project>-dev-s3-artifact
# under artifact_key (Step 1 item 6 automates the upload-then-apply sequence).
artifact_object_version = "your-uploaded-object-version-id"
